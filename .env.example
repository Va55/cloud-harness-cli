# Cloud Harness CLI — environment variables
# Copy to .env (not committed to git) and fill in values.
# Or set these in your shell/profile.

# AWS CLI profiles (default: use default profile)
# AWS_PROFILE=default

# Override default account
# CLOUD_HARNESS_ACCOUNT=123456789012

# Default region
# AWS_DEFAULT_REGION=us-east-1

# Custom config file path
# CLOUD_HARNESS_CONFIG=~/.config/cloud-harness/config.yaml

# Logging
# HARNESS_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
